/backend/                       @A_GITHUB_ID
/frontend/                      @A_GITHUB_ID
/infra/                         @A_GITHUB_ID
/.github/                       @A_GITHUB_ID
/docs/github-setup.md           @A_GITHUB_ID
/docs/api-keys.md               @A_GITHUB_ID

# B: 데이터·AI 트랙 (data-foundation, triage-model, llm-assistant)
/data/                          @B_GITHUB_ID
/ml-service/                    @B_GITHUB_ID

# data-pipeline: 실시간(Kafka/Flink)은 A, 배치(Spark/Airflow)는 B
/pipeline/                      @A_GITHUB_ID @B_GITHUB_ID
/pipeline/kafka/                @A_GITHUB_ID
/pipeline/flink/                @A_GITHUB_ID
/pipeline/spark/                @B_GITHUB_ID
/pipeline/airflow/              @B_GITHUB_ID

