# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 절대 커밋하지 않습니다(.gitignore에 등록됨). 이 파일에는 "키 이름"만 둡니다.

# --- PostgreSQL ---
POSTGRES_DB=symptom_care
POSTGRES_USER=symptom_care
POSTGRES_PASSWORD=change-me

# --- backend (Django) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# docker compose 안에서는 infra/docker-compose.yml이 POSTGRES_HOST=postgres로 덮어씁니다.
POSTGRES_HOST=localhost

# --- 공공데이터포털 (T21 병·의원 찾기, T60). 절차: docs/api-keys.md ---
# 포털 마이페이지의 "일반 인증키(Decoding)" 값
DATA_GO_KR_SERVICE_KEY=
# 요청 주소가 활용신청 페이지와 다를 때만 설정합니다(기본값은 infra/scripts/check-public-apis.sh).
# HIRA_HOSP_LIST_URL=
# NMC_ER_BEDS_URL=
# NMC_CLINIC_LIST_URL=

# --- Kakao (T21). 절차: docs/api-keys.md 6절 ---
# REST API 키: 서버 전용(좌표 → 시도·시군구 변환). 프론트로 보내지 않습니다.
KAKAO_REST_API_KEY=
# JavaScript 키: 브라우저 지도 SDK용. 화면에 노출되는 키라 Kakao 콘솔의 Web 플랫폼 도메인 등록으로 보호합니다.
VITE_KAKAO_MAP_JS_KEY=

# --- 분류 모델 (ml-service) ---
# 기본: 증상 일부를 빼고 학습한 모델(2026-11-13). 이전 베이스라인은 baseline-2026.11.0
# 모델 파일은 커밋하지 않습니다. 만들기: cd ml-service && python -m triage.train
MODEL_VERSION=dropout-2026.11.0

# --- LLM (Gemini, ADR 0001) ---
# 키 값은 여기 넣지 않습니다. 클라우드 세션은 환경의 Network secrets(x-goog-api-key)로, 로컬은 .env의 GEMINI_API_KEY로 넣습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 기본 모델이 429·5xx로 실패하면 쓰는 대체 모델(전환 로직은 T30)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 증상 추출 프롬프트에 넣을 증상 사전 후보 수(T30). 비우면 전체 사전
LLM_CANDIDATE_K=30
# Gemini 호출 1회 제한 시간(초). 넘으면 대체 모델로 전환, 설명은 기본 문구(T30 후속)
LLM_TIMEOUT_S=8
